{
  "name": "Offline Trip Guide",
  "short_name": "Trip",
  "description": "A trip guide that works offline: itinerary, opening hours, warnings and a record of the day.",
  "display": "standalone",
  "start_url": "./",
  "scope": "./",
  "orientation": "portrait",
  "theme_color": "#C65D21",
  "background_color": "#FDFBF7",
  "lang": "en",
  "icons": [
    { "src": "./icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [".json", ".trip"]
      }
    }
  ]
}
